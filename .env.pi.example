# ==============================================================================
# ThreatDetect — Raspberry Pi 5 Environment Configuration Template
# ==============================================================================
# Copy this file to .env.pi and fill in your actual values:
#   cp .env.pi.example .env.pi
#
# Then run:
#   sudo ./pi-setup.sh
# ==============================================================================

# ── Pi Network ──────────────────────────────────────────────────────────────
# pi-setup.sh automatically detects and updates these two fields on setup:
PI_IP=192.168.1.100
PI_HOSTNAME=raspberrypi

# ── LLM API Keys ───────────────────────────────────────────────────────────
# Free Router (OpenRouter) — primary
FREE_ROUTER_API_KEY=your_openrouter_api_key_here
FREE_ROUTER_MODEL=dots-studio/dots-3-note-preview:free

# Gemini fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ── Email Alerts ────────────────────────────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
ALERT_RECIPIENTS=security@example.com
